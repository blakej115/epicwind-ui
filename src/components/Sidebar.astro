---
import SidebarLink from "./SidebarLink.astro";
import Logo from "../assets/logo.svg";
---

<aside class="sidebar pb-sm top-0 overflow-y-auto md:sticky md:h-screen">
  <div class="logo px-md py-sm flex justify-center">
    <a href="/">
      <Logo class="h-auto w-full max-w-[186px]" />
    </a>
  </div>
  <ul>
    <SidebarLink href="/">Home</SidebarLink>
    <li>
      <div class="content px-sm py-xs">
        <h5>Intro</h5>
      </div>
      <ul>
        <SidebarLink href="/intro/get-started">Get Started</SidebarLink>
        <SidebarLink href="/intro/theming">Theming</SidebarLink>
      </ul>
    </li>
    <li>
      <div class="content px-sm py-xs">
        <h5>Theme</h5>
      </div>
      <ul>
        <SidebarLink href="/theme/colors">Colors</SidebarLink>
        <SidebarLink href="/theme/defaults">Defaults</SidebarLink>
        <SidebarLink href="/theme/gutter">Gutter</SidebarLink>
        <SidebarLink href="/theme/spacing">Spacing</SidebarLink>
      </ul>
    </li>
    <li>
      <div class="content px-sm py-xs">
        <h5>Components</h5>
      </div>
      <ul>
        <SidebarLink href="/component/accordion">Accordion <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/alert">Alert</SidebarLink>
        <SidebarLink href="/component/avatar">Avatar <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/bar">Bar <span class="tag variant-success">Layout</span></SidebarLink>
        <SidebarLink href="/component/blog">Blog <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/box">Box</SidebarLink>
        <SidebarLink href="/component/break">Break</SidebarLink>
        <SidebarLink href="/component/button">Button</SidebarLink>
        <SidebarLink href="/component/card">Card</SidebarLink>
        <SidebarLink href="/component/clear-fix">Clear Fix <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/content">Content</SidebarLink>
        <SidebarLink href="/component/footer">Footer <span class="tag variant-success">Layout</span> <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/form">Form</SidebarLink>
        <SidebarLink href="/component/header">Header <span class="tag variant-success">Layout</span></SidebarLink>
        <SidebarLink href="/component/hero">Hero</SidebarLink>
        <SidebarLink href="/component/list">List</SidebarLink>
        <SidebarLink href="/component/loader">Loader <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/logo">Logo</SidebarLink>
        <SidebarLink href="/component/nav">Nav <span class="tag variant-success">Layout</span></SidebarLink>
        <SidebarLink href="/component/progress">Progress <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/separator">Separator <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/screen-reader-only">Screen Reader Only <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/component/sidebar">Sidebar <span class="tag variant-success">Layout</span></SidebarLink>
        <SidebarLink href="/component/tag">Tag</SidebarLink>
        <SidebarLink href="/component/widget">Widget <span class="tag variant-muted">Coming Soon</span></SidebarLink>
      </ul>
    </li>
    <li>
      <div class="content px-sm py-xs">
        <h5>Utilities</h5>
      </div>
      <ul>
        <SidebarLink href="/utility/flex">Flex <span class="tag variant-success">Layout</span></SidebarLink>
        <SidebarLink href="/utility/float">Float <span class="tag variant-success">Layout</span> <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/utility/grid">Grid <span class="tag variant-success">Layout</span></SidebarLink>
        <SidebarLink href="/utility/gutter">Gutter</SidebarLink>
        <SidebarLink href="/utility/link">Link</SidebarLink>
        <SidebarLink href="/utility/variant">Variant <span class="tag variant-muted">Coming Soon</span></SidebarLink>
      </ul>
    </li>
    <li>
      <div class="content px-sm py-xs">
        <h5>Variants</h5>
      </div>
      <ul>
        <SidebarLink href="/variant/any-link">Any Link <span class="tag variant-error">Native</span></SidebarLink>
      </ul>
    </li>
    <li>
      <div class="content px-sm py-xs">
        <h5>Intergrations</h5>
      </div>
      <ul>
        <SidebarLink href="/integration/font-awesome">Font Awesome <span class="tag variant-muted">Coming Soon</span></SidebarLink>
        <SidebarLink href="/integration/swiper">Swiper <span class="tag variant-muted">Coming Soon</span></SidebarLink>
      </ul>
    </li>
  </ul>
</aside>
