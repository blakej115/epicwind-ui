---
import Layout from "../layouts/Layout.astro";
import Logo from "../assets/logo.svg";
---

<Layout>
  <section class="hero min-h-auto md:min-h-screen">
    <article class="content flex-grow items-center justify-center text-center">
      <Logo class="h-auto w-full" />
      <p>Lightweight, free, pure CSS components, utilities, & variants for Tailwind CSS.</p>
      <div class="buttons not-content justify-center">
        <a class="button variant-primary" href="/intro/get-started">Get Started</a>
      </div>
    </article>
  </section>
</Layout>
